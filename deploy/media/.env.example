# Emulated rekordbox USB for deploy/compose.emu.yaml (profile "media").
# cp deploy/media/.env.example deploy/media/.env, edit, then:
#   docker compose -f deploy/compose.emu.yaml --env-file deploy/media/.env --profile media up --build
# Do not put these in deploy/.env: compose reads that file for the plain emulation too.
# USB のルート、または scripts/media-snapshot.sh で作ったローカル複製
MEDIA_ROOT=/Volumes/nordblue2
MEDIA_DEVICE=4
MEDIA_TRACK_ID=308
