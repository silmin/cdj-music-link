# 公開デモ(deploy/compose.public.yaml)用。cp deploy/public.env.example deploy/public.env して編集する。
# 手順は deploy/public.md。
# USB の中身を置いた場所(.PIONEER/ と Contents/ がある場所)
MEDIA_ROOT=/srv/rekordbox-usb
# Cloudflare Tunnel のトークン
TUNNEL_TOKEN=
# 曲を切り替える間隔と、2 台が同時に再生している時間(秒)
SWITCH_SEC=45
OVERLAP_SEC=12
# 1 なら周回ごとにシャッフル、0 なら export 順
SHUFFLE=1
